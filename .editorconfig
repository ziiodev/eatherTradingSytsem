# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# JS / TS / JSON / YAML / Markdown / CSS — 2 spaces
[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,yml,yaml,md,mdx,css,scss,html}]
indent_size = 2

# Python — 4 spaces (PEP 8)
[*.py]
indent_size = 4

# Makefiles require tabs
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

# TOML — 2 spaces
[*.toml]
indent_size = 2

# Shell scripts
[*.{sh,bash,zsh,fish}]
indent_size = 2
