# .env.example — template for local development environment variables.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored (see .gitignore). NEVER commit real secrets.
# This template documents the env vars consumed by docker-compose.yml,
# alembic/env.py (apps/api), and future backend/frontend code.

# -----------------------------------------------------------------------------
# Postgres (consumed by docker-compose.yml's `postgres` service)
# -----------------------------------------------------------------------------
# Password for the `aether` superuser inside the Postgres container.
# Default in docker-compose.yml is `dev_only_change_me` — override for any
# non-throwaway environment.
POSTGRES_PASSWORD=dev_only_change_me

# -----------------------------------------------------------------------------
# Backend (apps/api) — SQLAlchemy / Alembic
# -----------------------------------------------------------------------------
# Async SQLAlchemy URL. asyncpg driver. Host `localhost` when running the API
# on the host machine against the dockerized Postgres; use `postgres` (the
# compose service name) when the API itself runs inside the compose network.
DATABASE_URL=postgresql+asyncpg://aether:dev_only_change_me@localhost:5432/aether

# Sync URL is sometimes useful for tooling that doesn't speak asyncpg (e.g.
# alembic offline mode, ad-hoc psql-style scripts). Optional.
# DATABASE_URL_SYNC=postgresql+psycopg://aether:dev_only_change_me@localhost:5432/aether

# -----------------------------------------------------------------------------
# Auth (Phase 3 + rs256-jwt-migration)
# -----------------------------------------------------------------------------
# Algorithm for access-token signing. RS256 is the default since the
# rs256-jwt-migration. HS256 is accepted transitionally for verification only
# (see JWT_LEGACY_HS256_VERIFY_ENABLED) and is removed by the cleanup change.
JWT_ALGORITHM=RS256

# RS256 keypair — generate dev keys with:
#   cd apps/api && uv run python scripts/gen_dev_keys.py
# Then point these at the generated files (paths are resolved relative to
# the API process's working directory, which is apps/api/ in dev).
JWT_PRIVATE_KEY_PATH=.dev_keys/private.pem
JWT_PUBLIC_KEY_PATH=.dev_keys/public.pem

# Alternatively, supply the PEM contents inline (KMS-injected, multi-line):
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Transitional HS256 verify-only fallback. Drains within one access-token
# TTL (15 min) once issuance flips to RS256. Set to false to harden the
# verifier against any HS256-signed token whatsoever.
JWT_LEGACY_HS256_VERIFY_ENABLED=true

# JWT shared secret for the HS256 verify-only fallback. MUST be at least 32
# chars or the API will refuse to boot. The cleanup change removes this
# requirement entirely.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_change_me_change_me_change_me_change_me_xx

# Cookie hardening — leave OFF in dev (HTTP localhost), turn ON in prod.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Lockout policy (defaults shown).
# LOCKOUT_THRESHOLD=5
# LOCKOUT_WINDOW_MINUTES=15

# Token TTLs (defaults shown).
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14

# Signup mode. False = admin-only signup (v1 default).
# SIGNUP_OPEN=false

# Runtime environment: dev | test | prod.
ENVIRONMENT=dev

# -----------------------------------------------------------------------------
# MFA (TOTP, RFC 6238) — see services/secret_box.py + services/mfa.py.
# -----------------------------------------------------------------------------
# Fernet key wrapping the per-user TOTP secret in users.mfa_secret_ref.
# MUST be 32 random bytes URL-safe-base64 (the Fernet shape). Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Required whenever any user has mfa_enabled=true — the route handlers
# refuse to operate without it. ROTATING this key invalidates every
# enrolled TOTP secret on disk; do not change in prod without a plan.
# MFA_SECRET_KEY=

# HS256 signing secret for the short-lived `aether_mfa_pending` cookie
# minted during the login two-step. Path-scoped to /api/auth/login/mfa
# and lives 5 minutes; rotating it invalidates only in-flight challenges
# and is safe to do at any time. MUST be at least 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MFA_PENDING_SECRET=

# TTL of the `aether_mfa_pending` cookie in seconds. Spec upper bound is
# 5 minutes; do not extend without a security review.
# MFA_PENDING_TTL_SECONDS=300

# CORS allow-list (JSON list of origins) — defaults to ["http://localhost:3000"].
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# MT5 live trading (mt5-integration change)
# -----------------------------------------------------------------------------
# Master kill-switch for live order placement. When false (v1 default),
# POST /api/projects/{id}/orders returns 503. Read endpoints
# (/account, /positions, /history, /candles, GET /orders) work regardless —
# they only depend on the per-project MCP container being reachable.
AETHER_LIVE_ORDERS_ENABLED=false

# How long a large-order approval row stays "pending" before the gate
# marks it "expired". 5 minutes default; bound on operational risk if
# the operator walks away.
# AETHER_ORDER_APPROVAL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# MQL5 → Python translator (mql5-to-py-translator change)
# -----------------------------------------------------------------------------
# One-shot UX tool exposed at POST /api/tools/mql5-to-python. Charter rule:
# MQL5 is NEVER persisted or executed by Aether — the endpoint takes MQL5
# in, returns Python out, and discards the input immediately. Audit log
# records sizes only, not content.

# Master feature flag. When false (v1 default), the endpoint returns 503
# with {detail: "translator not enabled"}.
# MQL5_TRANSLATOR_ENABLED=false

# Anthropic API key (SecretStr). Required when the flag above is true; the
# endpoint returns 503 with {detail: "translator not configured"} otherwise.
# The structlog PII scrubber masks this on accidental dumps.
# ANTHROPIC_API_KEY=

# Anthropic model id used for translation. The default is the current
# Claude Sonnet; bump as new model ids ship.
# MQL5_TRANSLATOR_MODEL=claude-sonnet-4-20250514

# Max bytes of MQL5 input the endpoint will accept. Anything larger is
# rejected with 413 before the upstream call (so the API key isn't
# burned on oversize jobs). 50 KiB is already generous for an EA.
# MQL5_TRANSLATOR_MAX_INPUT_BYTES=51200

# -----------------------------------------------------------------------------
# MCP / MT5 server (./mcp) — set INSIDE the per-project container
# -----------------------------------------------------------------------------
# Transport: stdio (legacy Claude-Desktop launch) or tcp (production).
# The apps/api MCPClient dials over TCP, so per-project containers MUST
# set transport=tcp.
# MT5_MCP_TRANSPORT=tcp
# MT5_MCP_HOST=0.0.0.0
# MT5_MCP_PORT=8765

# Live MT5 enable flag (per-container). When false the live tools refuse
# with LIVE_DISABLED — backtest tools are unaffected.
# MT5_LIVE_ENABLED=false

# Broker credentials. The MCP server holds these so apps/api never
# sees raw credentials. Login is redacted in logs (last 4 digits only);
# password is never logged.
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=ICMarkets-Demo

# -----------------------------------------------------------------------------
# Frontend (apps/web) — filled in Phase 4
# -----------------------------------------------------------------------------
# Public API base URL used by the dashboard. The edge middleware also reads
# this to construct the JWKS URL (``${NEXT_PUBLIC_API_URL}/.well-known/jwks.json``)
# for RS256 access-token verification.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────
# Test DB — pytest la usa en vez de DATABASE_URL para no truncar la BD
# de dev. Crearla con:
#   docker compose exec postgres psql -U aether -d postgres \
#     -c 'CREATE DATABASE aether_test OWNER aether;'
# Y aplicar migraciones:
#   cd apps/api && DATABASE_URL="$TEST_DATABASE_URL" uv run alembic upgrade head
# ─────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+asyncpg://aether:dev_only_change_me@localhost:5435/aether_test
